# version: '3.8'

services:
  db:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_DB: ${DB_DATABASE}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - app-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME}"]
      interval: 5s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits: { memory: 1G }

  db-pegawai:
    image: mysql:8.0
    command: --innodb-flush-log-at-trx-commit=0 --innodb-doublewrite=0 --skip-log-bin
    environment:
      MYSQL_ROOT_PASSWORD: ${PEGAWAI_DB_ROOT_PASSWORD}
      MYSQL_DATABASE: ${PEGAWAI_DB_DATABASE:-siantar}
    ports:
      - "${PEGAWAI_DB_PORT:-3307}:3306"
    volumes:
      - pegawaidata:/var/lib/mysql
      - ./m_peg.sql:/docker-entrypoint-initdb.d/m_peg.sql
    networks:
      - app-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${PEGAWAI_DB_ROOT_PASSWORD}"]
      interval: 5s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '1.0'
        reservations:
          memory: 256M

  redis:
    image: redis:7-alpine
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - redisdata:/data
    networks:
      - app-network
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 256M      # Redis tidak butuh banyak
          cpus: '0.5'
        reservations:
          memory: 128M
    

  laravel:
    build:
      context: ./php             
      dockerfile: Dockerfile     
    ports:
      - "${APP_PORT:-8080}:8000"  
      - "${VITE_PORT:-5173}:5173" 
    env_file:
      - ./php/.env                
    environment:
      - DB_HOST=db
      - REDIS_HOST=redis
      - PYTHON_AI_URL=http://python-ai:8000
      - PEGAWAI_DB_HOST=db-pegawai
      - PEGAWAI_DB_PORT=3306
      - PEGAWAI_DB_DATABASE=${PEGAWAI_DB_DATABASE:-siantar}
      - PEGAWAI_DB_USERNAME=root
      - PEGAWAI_DB_PASSWORD=${PEGAWAI_DB_ROOT_PASSWORD}
    volumes:
      - ./php:/var/www/html
      - /var/www/html/node_modules
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      python-ai:
        condition: service_started
      db-pegawai:
        condition: service_healthy
    networks:
      - app-network
    # ✅ BATASI MEMORY DI SINI
    deploy:
      resources:
        limits:
          memory: 4G        # Maksimal 1 GB RAM. 
          cpus: '4.0'       # Maksimal 1 CPU core
        reservations:
          memory: 512M      # Minimal 512 MB (guaranteed

  python-ai:
    build:
      context: ./python          
      dockerfile: Dockerfile   
    ports:
      - "${PYTHON_PORT:-8001}:8000"
    env_file:
      - ./python/.env           
    environment:
      - DB_HOST=db
      - PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
      - PYTORCH_NVML_BASED_CUDA_CHECK=0
    volumes:
      - ./python:/app
    depends_on:
      db:
        condition: service_healthy
    networks:
      - app-network
    deploy:
          resources:
            limits:
              memory: 4G        # Maksimal 6 GB
              cpus: '4.0'       # Maksimal 4 CPU core
            reservations:
              memory: 1.5G      # Minimal 1.5 GB
              # GPU reservation dihapus - Mac tidak punya GPU NVIDIA / device passthrough
              # Kalau nanti deploy ke server Linux dengan GPU NVIDIA + NVIDIA Container Toolkit,
              # bisa diaktifkan lagi dengan menambahkan blok "devices" di sini.
    command: gunicorn main:app -w 1 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --timeout 300

    
volumes:
  pgdata:    
  redisdata:
  pegawaidata:

networks:
  app-network:
    driver: bridge